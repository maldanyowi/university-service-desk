                            <circle cx="414" cy="245" r="50"
                                    fill="#dff4f8" />

                            <path d="M40 238 C105 183, 146 280, 215 225 S340 150, 438 203"
                                  fill="none"
                                  stroke="#b9e2ec"
                                  stroke-width="3"
                                  stroke-dasharray="7 8" />

                            <circle cx="40" cy="238" r="7"
                                    fill="#65bdd5" />

                            <circle cx="215" cy="225" r="7"
                                    fill="#65bdd5" />

                            <circle cx="438" cy="203" r="7"
                                    fill="#65bdd5" />

                            <rect x="92" y="48"
                                  width="296"
                                  height="196"
                                  rx="18"
                                  fill="#304f59" />

                            <rect x="105" y="62"
                                  width="270"
                                  height="167"
                                  rx="10"
                                  fill="#ffffff" />

                            <rect x="105" y="62"
                                  width="270"
                                  height="31"
                                  rx="10"
                                  fill="#ccebf3" />

                            <circle cx="124" cy="77" r="5"
                                    fill="#65bdd5" />

                            <circle cx="141" cy="77" r="5"
                                    fill="#8ed0e1" />

                            <circle cx="158" cy="77" r="5"
                                    fill="#abdce8" />

                            <rect x="123" y="111"
                                  width="72"
                                  height="10"
                                  rx="5"
                                  fill="#cae3e9" />

                            <rect x="123" y="137"
                                  width="205"
                                  height="13"
                                  rx="6"
                                  fill="#edf5f7" />

                            <circle cx="137" cy="143" r="6"
                                    fill="#65bdd5" />

                            <rect x="154" y="139"
                                  width="102"
                                  height="8"
                                  rx="4"
                                  fill="#b9d5dc" />

                            <rect x="123" y="160"
                                  width="205"
                                  height="13"
                                  rx="6"
                                  fill="#edf5f7" />

                            <circle cx="137" cy="166" r="6"
                                    fill="#f0c979" />

                            <rect x="154" y="162"
                                  width="124"
                                  height="8"
                                  rx="4"
                                  fill="#b9d5dc" />

                            <rect x="123" y="183"
                                  width="205"
                                  height="13"
                                  rx="6"
                                  fill="#edf5f7" />

                            <circle cx="137" cy="189" r="6"
                                    fill="#87c89a" />

                            <rect x="154" y="185"
                                  width="88"
                                  height="8"
                                  rx="4"
                                  fill="#b9d5dc" />

                            <path d="M68 244 H412 L448 270 Q452 275 443 278 H37 Q28 275 32 270 Z"
                                  fill="#40636e" />

                            <rect x="185" y="251"
                                  width="110"
                                  height="9"
                                  rx="4"
                                  fill="#b8dce5" />

                            <g transform="translate(330 175)">
                                <path d="M42 0 L78 14 V45 C78 72 62 91 42 101 C22 91 6 72 6 45 V14 Z"
                                      fill="#65bdd5" />

                                <path d="M42 12 L66 21 V44 C66 62 56 75 42 83 C28 75 18 62 18 44 V21 Z"
                                      fill="#eaf8fc" />

                                <path d="M30 46 L39 55 L56 35"
                                      fill="none"
                                      stroke="#4399b2"
                                      stroke-width="7"
                                      stroke-linecap="round"
                                      stroke-linejoin="round" />
                            </g>

                            <g transform="translate(44 114)">
                                <path d="M10 47 C10 19 28 2 53 2 C78 2 96 19 96 47"
                                      fill="none"
                                      stroke="#65bdd5"
                                      stroke-width="10"
                                      stroke-linecap="round" />

                                <rect x="3" y="43"
                                      width="18"
                                      height="45"
                                      rx="8"
                                      fill="#4399b2" />

                                <rect x="85" y="43"
                                      width="18"
                                      height="45"
                                      rx="8"
                                      fill="#4399b2" />

                                <path d="M94 84 C94 101 80 106 67 106"
                                      fill="none"
                                      stroke="#65bdd5"
                                      stroke-width="6"
                                      stroke-linecap="round" />

                                <circle cx="62" cy="106" r="7"
                                        fill="#4399b2" />
                            </g>
                        </svg>
                    </div>
                </section>
            </div>

            <div class="col-lg-7">
                <section class="form-panel">
                    <div class="form-label-small">Account access</div>

                    <h1>Sign in</h1>

                    <p class="form-subtitle">
                        Enter your account details to access the service desk.
                    </p>

                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"
                             role="alert">
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email"
                                   class="form-control"
                                   autocomplete="username"
                                   placeholder="name@example.com" />

                            <label asp-for="Input.Email">
                                Email address
                            </label>

                            <span asp-validation-for="Input.Email"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   placeholder="Password" />

                            <label asp-for="Input.Password">
                                Password
                            </label>

                            <span asp-validation-for="Input.Password"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input"
                                       asp-for="Input.RememberMe" />

                                <label class="form-check-label"
                                       asp-for="Input.RememberMe">
                                    Remember me
                                </label>
                            </div>

                            <a asp-page="./ForgotPassword"
                               class="account-help-link">
                                Forgot password?
                            </a>
                        </div>

                        <button id="login-submit"
                                type="submit"
                                class="sign-in-button w-100">
                            Sign in
                        </button>

                        <div class="text-center mt-4">
                            <p class="mb-3">
                                Don’t have an account?

                                <a asp-page="./Register"
                                   asp-route-returnUrl="@Model.ReturnUrl"
                                   class="fw-semibold">
                                    Create an account
                                </a>
                            </p>

                            <a asp-page="./ResendEmailConfirmation"
                               class="resend-link">
                                Resend email confirmation
                            </a>
                        </div>
                    </form>
                </section>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}