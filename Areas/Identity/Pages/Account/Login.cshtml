@page
@model LoginModel

@{
    ViewData["Title"] = "Sign In";
}

<style>
    .login-page {
        min-height: 78vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px 20px;
        background: #f5fbfd;
    }

    .login-shell {
        width: 100%;
        max-width: 1080px;
        overflow: hidden;
        border: 1px solid #dceef3;
        border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 22px 55px rgba(54, 116, 134, 0.13);
    }

    .visual-panel {
        min-height: 650px;
        padding: 45px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: #eaf8fc;
    }

    .brand-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 38px;
    }

    .brand-logo {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: #65bdd5;
        color: #ffffff;
        font-size: 23px;
        font-weight: 800;
        box-shadow: 0 8px 18px rgba(80, 168, 193, 0.22);
    }

    .brand-text strong {
        display: block;
        color: #285866;
        font-size: 15px;
        letter-spacing: 0.7px;
    }

    .brand-text span {
        color: #6d929d;
        font-size: 12px;
    }

    .visual-panel h2 {
        margin-bottom: 14px;
        color: #285866;
        font-size: 25px;
        font-weight: 750;
        white-space: nowrap;
    }

    .visual-description {
        max-width: 410px;
        margin-bottom: 28px;
        color: #638690;
        font-size: 16px;
        line-height: 1.7;
    }

    .technology-visual {
        width: 100%;
        padding: 16px;
        border: 1px solid rgba(101, 189, 213, 0.22);
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.55);
    }

    .technology-visual svg {
        display: block;
        width: 100%;
        height: auto;
    }

    .form-panel {
        min-height: 650px;
        padding: 65px 70px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .form-label-small {
        margin-bottom: 12px;
        color: #65aabd;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.4px;
        text-transform: uppercase;
    }

    .form-panel h1 {
        margin-bottom: 10px;
        color: #263b42;
        font-size: 40px;
        font-weight: 750;
    }

    .form-subtitle {
        margin-bottom: 34px;
        color: #7b8c91;
    }

    .form-panel .form-control {
        min-height: 58px;
        border: 1px solid #dce5e8;
        border-radius: 12px;
        background: #fcfeff;
    }

    .form-panel .form-control:focus {
        border-color: #65bdd5;
        box-shadow: 0 0 0 4px rgba(101, 189, 213, 0.15);
    }

    .sign-in-button {
        min-height: 54px;
        border: 0;
        border-radius: 12px;
        background: #65bdd5;
        color: #ffffff;
        font-weight: 700;
        transition: 0.2s ease;
    }

    .sign-in-button:hover {
        background: #50a9c2;
        color: #ffffff;
        transform: translateY(-1px);
    }

    .form-panel a {
        color: #4399b2;
        text-decoration: none;
    }

    .form-panel a:hover {
        color: #28758b;
    }

    .account-help-link {
        display: inline-flex;
        align-items: center;
        padding: 7px 11px;
        color: #378da6 !important;
        background: #edf8fb;
        border: 1px solid #c8e8f0;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 650;
        text-decoration: none !important;
        transition: 0.2s ease;
    }

    .account-help-link:hover {
        color: #246e83 !important;
        background: #e1f3f8;
        border-color: #a9d9e5;
    }

    .resend-link {
        display: inline-block;
        padding: 8px 13px;
        color: #668087 !important;
        background: transparent;
        border: 1px solid #d6e4e8;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none !important;
        transition: 0.2s ease;
    }

    .resend-link:hover {
        color: #378da6 !important;
        background: #f1f9fb;
        border-color: #b9dfe8;
    }

    @@media (max-width: 991px) {
        .form-panel {
            min-height: auto;
            padding: 50px 35px;
        }

        .login-shell {
            max-width: 650px;
        }
    }

    @@media (max-width: 576px) {
        .login-page {
            padding: 25px 14px;
        }

        .form-panel {
            padding: 40px 24px;
        }

        .form-panel h1 {
            font-size: 34px;
        }
    }
</style>

<div class="login-page">
    <div class="login-shell">
        <div class="row g-0">
            <div class="col-lg-5 d-none d-lg-flex">
                <section class="visual-panel w-100">
                    <div class="brand-row">
                        <div class="brand-logo">M</div>

                        <div class="brand-text">
                            <strong>MARWAH</strong>
                            <span>University Service Desk</span>
                        </div>
                    </div>

                    <h2>Welcome to the IT Service Desk</h2>

                    <p class="visual-description">
                        Submit technical support requests and track their
                        progress from submission to resolution.
                    </p>

                    <div class="technology-visual">
                        <svg viewBox="0 0 480 320"
                             xmlns="http://www.w3.org/2000/svg"
                             aria-label="Technology support illustration">

                            <circle cx="75" cy="68" r="42"
