@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
}

<style>
    .password-page {
        min-height: 78vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px 20px;
        background:
            radial-gradient(
                circle at 15% 20%,
                rgba(117, 200, 222, 0.18),
                transparent 28%
            ),
            #f5fbfd;
    }

    .password-card {
        width: 100%;
        max-width: 560px;
        padding: 52px;
        background: #ffffff;
        border: 1px solid #dceef3;
        border-radius: 22px;
        box-shadow: 0 18px 45px rgba(54, 116, 134, 0.12);
    }

    .password-icon {
        width: 64px;
        height: 64px;
        margin-bottom: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        background: #65bdd5;
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(80, 168, 193, 0.22);
    }

    .password-icon svg {
        width: 31px;
        height: 31px;
    }

    .page-label {
        margin-bottom: 10px;
        color: #65aabd;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.4px;
        text-transform: uppercase;
    }

    .password-card h1 {
        margin: 0 0 12px;
        color: #263b42;
        font-size: 36px;
        font-weight: 750;
    }

    .page-description {
        margin-bottom: 30px;
        color: #71858c;
        font-size: 16px;
        line-height: 1.65;
    }

    .password-card .form-control {
        min-height: 58px;
        border: 1px solid #dce5e8;
        border-radius: 12px;
        background: #fcfeff;
    }

    .password-card .form-control:focus {
        border-color: #65bdd5;
        box-shadow: 0 0 0 4px rgba(101, 189, 213, 0.15);
    }

    .reset-button {
        width: 100%;
        min-height: 54px;
        margin-top: 8px;
        border: 0;
        border-radius: 12px;
        color: #ffffff;
        background: #65bdd5;
        font-weight: 700;
        transition: 0.2s ease;
    }

    .reset-button:hover {
        color: #ffffff;
        background: #50a9c2;
        transform: translateY(-1px);
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 24px;
        color: #4399b2;
        font-size: 14px;
        font-weight: 650;
        text-decoration: none;
    }

    .back-link:hover {
        color: #28758b;
    }

    @@media (max-width: 576px) {
        .password-page {
            padding: 25px 14px;
        }

        .password-card {
            padding: 38px 25px;
        }

        .password-card h1 {
            font-size: 31px;
        }
    }
</style>

<div class="password-page">
    <section class="password-card">
        <div class="password-icon">
            <svg viewBox="0 0 24 24"
                 fill="none"
                 xmlns="http://www.w3.org/2000/svg"
                 aria-hidden="true">

                <path d="M4 6.5L12 12L20 6.5"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round" />

                <rect x="3"
                      y="5"
                      width="18"
                      height="14"
                      rx="3"
                      stroke="currentColor"
                      stroke-width="2" />
            </svg>
        </div>

        <div class="page-label">Account recovery</div>

        <h1>Forgot your password?</h1>

        <p class="page-description">
            Enter the email address associated with your account
            to request a password reset link.
        </p>

        <form method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"
                 role="alert">
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       placeholder="name@example.com" />

                <label asp-for="Input.Email">
                    Email address
                </label>

                <span asp-validation-for="Input.Email"
                      class="text-danger">
                </span>
            </div>

            <button type="submit"
                    class="reset-button">
                Send Reset Link
            </button>
        </form>

        <a asp-page="./Login"
           class="back-link">
            <span>←</span>
            Back to sign in
        </a>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}