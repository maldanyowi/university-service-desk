@model UniversityServiceDesk.Models.ServiceRequest

@{
    ViewData["Title"] = "Request Details";

    var priorityClass = Model.Priority switch
    {
        "High" => "priority-high",
        "Low" => "priority-low",
        _ => "priority-medium"
    };

    var statusClass = Model.Status switch
    {
        "Completed" => "status-completed",
        "In Progress" => "status-progress",
        _ => "status-new"
    };
}

<style>
    .details-page {
        min-height: 78vh;
        padding: 48px 20px;
        background: #f5fbfd;
    }

    .details-container {
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
    }

    .details-heading {
        margin-bottom: 27px;
    }

    .page-label {
        margin-bottom: 8px;
        color: #65aabd;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.4px;
        text-transform: uppercase;
    }

    .details-heading h1 {
        margin-bottom: 8px;
        color: #263b42;
        font-size: 38px;
        font-weight: 750;
    }

    .details-heading p {
        margin: 0;
        color: #74898f;
    }

    .details-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #dceef3;
        border-radius: 22px;
        box-shadow: 0 18px 45px rgba(54, 116, 134, 0.11);
    }

    .details-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 25px 30px;
        background: #eaf8fc;
        border-bottom: 1px solid #dfedf1;
    }

    .request-reference {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .request-number {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        background: #65bdd5;
        border-radius: 14px;
        font-size: 14px;
        font-weight: 800;
    }

    .request-reference strong {
        display: block;
        margin-bottom: 3px;
        color: #285866;
        font-size: 17px;
    }

    .request-date {
        color: #76939b;
        font-size: 13px;
    }

    .badge-group {
        display: flex;
        align-items: center;
        gap: 9px;
        flex-wrap: wrap;
    }

    .detail-badge {
        padding: 7px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 750;
    }

    .priority-high {
        color: #a53b46;
        background: #f9e2e5;
    }

    .priority-medium {
        color: #82651f;
        background: #f8edcf;
    }

    .priority-low {
        color: #486a75;
        background: #e1f0f4;
    }

    .status-new {
        color: #33778c;
        background: #dff2f7;
    }

    .status-progress {
        color: #82651f;
        background: #f8edcf;
    }

    .status-completed {
        color: #39704a;
        background: #deefe3;
    }

    .details-body {
        padding: 36px 38px;
    }

    .detail-section-title {
        margin-bottom: 20px;
        color: #2f4b54;
        font-size: 18px;
        font-weight: 750;
    }

    .detail-group {
        margin-bottom: 24px;
    }

    .detail-label {
        display: block;
        margin-bottom: 7px;
        color: #7b9299;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.8px;
        text-transform: uppercase;
    }

    .detail-value {
        color: #2f4147;
        font-size: 15px;
        line-height: 1.6;
    }

    .empty-value {
        color: #9aabb0;
        font-style: italic;
    }

    .description-box {
        min-height: 125px;
        padding: 18px;
        color: #40565d;
        background: #f9fcfd;
        border: 1px solid #e0ebee;
        border-radius: 12px;
        line-height: 1.7;
    }

    .details-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 22px 30px;
        background: #fcfefe;
        border-top: 1px solid #e4eef1;
    }

    .back-button {
        min-height: 48px;
        padding: 0 22px;
        display: inline-flex;
        align-items: center;
        color: #5e747b;
        background: #ffffff;
        border: 1px solid #d4e1e5;
        border-radius: 11px;
        font-weight: 650;
        text-decoration: none;
    }

    .back-button:hover {
        color: #344e56;
        background: #f1f8fa;
    }

    .edit-button {
        min-height: 48px;
        padding: 0 22px;
        display: inline-flex;
        align-items: center;
        color: #ffffff;
        background: #65bdd5;
        border-radius: 11px;
        font-weight: 700;
        text-decoration: none;
    }

    .edit-button:hover {
        color: #ffffff;
        background: #50a9c2;
    }

    @@media (max-width: 700px) {
        .details-page {
            padding: 30px 14px;
        }

        .details-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .details-body {
            padding: 28px 24px;
        }

        .details-footer {
            align-items: stretch;
            flex-direction: column;
        }

        .back-button,
        .edit-button {
            justify-content: center;
        }
    }
</style>

<div class="details-page">
    <div class="details-container">
        <div class="details-heading">
            <div class="page-label">IT Service Desk</div>

            <h1>Request details</h1>

            <p>
                Review the submitted issue and its current progress.
            </p>
        </div>

        <div class="details-card">
            <div class="details-header">
                <div class="request-reference">
                    <div class="request-number">
                        #@Model.Id
                    </div>

                    <div>
                        <strong>@Model.Title</strong>

                        <div class="request-date">
                            Submitted
                            @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                        </div>
                    </div>
                </div>

                <div class="badge-group">
                    <span class="detail-badge @priorityClass">
                        @Model.Priority priority
                    </span>

                    <span class="detail-badge @statusClass">
                        @Model.Status
                    </span>
                </div>
            </div>

            <div class="details-body">
                <div class="row">
                    <div class="col-md-6">
                        <h2 class="detail-section-title">
                            Requester information
                        </h2>

                        <div class="detail-group">
                            <span class="detail-label">
                                Requester name
                            </span>

                            <div class="detail-value">
                                @Model.RequesterName
                            </div>
                        </div>

                        <div class="detail-group">
                            <span class="detail-label">
                                Department
                            </span>

                            <div class="detail-value">
                                @Model.Department
                            </div>
                        </div>

                        <div class="detail-group">
                            <span class="detail-label">
                                Contact number
                            </span>

                            @if (!string.IsNullOrWhiteSpace(
                                Model.ContactNumber))
                            {
                                <div class="detail-value">
                                    @Model.ContactNumber
                                </div>
                            }
                            else
                            {
                                <div class="detail-value empty-value">
                                    Not provided
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h2 class="detail-section-title">
                            Request information
                        </h2>

                        <div class="detail-group">
                            <span class="detail-label">
                                Issue title
                            </span>

                            <div class="detail-value">
                                @Model.Title
                            </div>
                        </div>

                        <div class="detail-group">
                            <span class="detail-label">
                                Created date
                            </span>

                            <div class="detail-value">
                                @Model.CreatedAt.ToString(
                                    "dd MMMM yyyy, hh:mm tt")
                            </div>
                        </div>
                    </div>
                </div>

                <div class="detail-group mb-0">
                    <span class="detail-label">
                        Description
                    </span>

                    <div class="description-box">
                        @Model.Description
                    </div>
                </div>
            </div>

            <div class="details-footer">
                <a asp-action="Index"
                   class="back-button">
                    Back to dashboard
                </a>

                @if (User.IsInRole("Technician"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="edit-button">
                        Update request
                    </a>
                }
            </div>
        </div>
    </div>
</div>