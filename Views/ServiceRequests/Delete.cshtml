@model UniversityServiceDesk.Models.ServiceRequest

@{
    ViewData["Title"] = "Delete Request";
}

<style>
    .delete-page {
        min-height: 78vh;
        padding: 48px 20px;
        background: #f5fbfd;
    }

    .delete-container {
        width: 100%;
        max-width: 850px;
        margin: 0 auto;
    }

    .page-heading {
        margin-bottom: 27px;
    }

    .page-label {
        margin-bottom: 8px;
        color: #c87882;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.4px;
        text-transform: uppercase;
    }

    .page-heading h1 {
        margin-bottom: 8px;
        color: #263b42;
        font-size: 38px;
        font-weight: 750;
    }

    .page-heading p {
        margin: 0;
        color: #74898f;
    }

    .delete-card {
        overflow: hidden;
        border: 1px solid #efdfe2;
        border-radius: 22px;
        background: #ffffff;
        box-shadow: 0 18px 45px rgba(90, 71, 75, 0.11);
    }

    .warning-section {
        padding: 30px;
        border-bottom: 1px solid #f0e3e5;
        background: #fff7f8;
    }

    .warning-content {
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }

    .warning-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 15px;
        background: #f5dce0;
        color: #ae4f5b;
        font-size: 24px;
        font-weight: 800;
    }

    .warning-section h2 {
        margin-bottom: 6px;
        color: #773a43;
        font-size: 20px;
        font-weight: 750;
    }

    .warning-section p {
        margin: 0;
        color: #95656c;
        font-size: 14px;
        line-height: 1.6;
    }

    .request-summary {
        padding: 35px;
    }

    .summary-title {
        margin-bottom: 24px;
        color: #2e4a53;
        font-size: 18px;
        font-weight: 750;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px 35px;
    }

    .summary-item.full-width {
        grid-column: 1 / -1;
    }

    .summary-label {
        display: block;
        margin-bottom: 6px;
        color: #7b9299;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.7px;
        text-transform: uppercase;
    }

    .summary-value {
        color: #30454c;
        font-size: 15px;
        line-height: 1.6;
    }

    .description-box {
        padding: 16px;
        border: 1px solid #e0ebee;
        border-radius: 11px;
        background: #f9fcfd;
    }

    .delete-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 13px;
        padding: 22px 30px;
        border-top: 1px solid #e5eef1;
        background: #fcfefe;
    }

    .cancel-button {
        min-height: 49px;
        padding: 0 23px;
        display: inline-flex;
        align-items: center;
        border: 1px solid #d4e1e5;
        border-radius: 11px;
        background: #ffffff;
        color: #5e747b;
        font-weight: 650;
        text-decoration: none;
    }

    .cancel-button:hover {
        background: #f1f8fa;
        color: #344e56;
    }

    .delete-button {
        min-height: 49px;
        padding: 0 23px;
        border: 0;
        border-radius: 11px;
        background: #c85f6c;
        color: #ffffff;
        font-weight: 700;
        transition: 0.2s ease;
    }

    .delete-button:hover {
        background: #ad4e59;
        transform: translateY(-1px);
    }
</style>

<div class="delete-page">
    <div class="delete-container">

        <div class="page-heading">
            <div class="page-label">Delete request</div>

            <h1>Confirm deletion</h1>

            <p>
                Review the request before permanently removing it.
            </p>
        </div>

        <div class="delete-card">

            <section class="warning-section">
                <div class="warning-content">

                    <div class="warning-icon">!</div>

                    <div>
                        <h2>This action cannot be undone</h2>

                        <p>
                            Deleting this request will permanently remove
                            its information from the service desk.
                        </p>
                    </div>

                </div>
            </section>

            <section class="request-summary">

                <h2 class="summary-title">
                    Request #@Model.Id
                </h2>

                <div class="summary-grid">

                    <div class="summary-item">
                        <span class="summary-label">Requester</span>

                        <div class="summary-value">
                            @Model.RequesterName
                        </div>
                    </div>

                    <div class="summary-item">
                        <span class="summary-label">Department</span>

                        <div class="summary-value">
                            @Model.Department
                        </div>
                    </div>

                    <div class="summary-item">
                        <span class="summary-label">Priority</span>

                        <div class="summary-value">
                            @Model.Priority
                        </div>
                    </div>

                    <div class="summary-item">
                        <span class="summary-label">Status</span>

                        <div class="summary-value">
                            @Model.Status
                        </div>
                    </div>

                    <div class="summary-item full-width">
                        <span class="summary-label">Issue title</span>

                        <div class="summary-value">
                            @Model.Title
                        </div>
                    </div>

                    <div class="summary-item full-width">
                        <span class="summary-label">Description</span>

                        <div class="summary-value description-box">
                            @Model.Description
                        </div>
                    </div>

                </div>
            </section>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />

                <div class="delete-footer">
                    <a asp-action="Index"
                       class="cancel-button">
                        Cancel
                    </a>

                    <button type="submit"
                            class="delete-button">
                        Delete request
                    </button>
                </div>
            </form>

        </div>

    </div>
</div>