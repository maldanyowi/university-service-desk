<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - University Service Desk</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
        :root {
            --brand-blue: #42a5c6;
            --brand-dark: #153747;
            --brand-light: #eef9fc;
            --text-muted: #647681;
        }

        body {
            background-color: #f7fbfc;
            color: #1f2d34;
        }

        .main-navbar {
            min-height: 72px;
            background: rgba(255, 255, 255, 0.96);
            border-bottom: 1px solid #d9e9ee;
        }

        .brand-mark {
            width: 40px;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            background: var(--brand-blue);
            border-radius: 12px;
            font-size: 20px;
            font-weight: 800;
            box-shadow: 0 6px 16px rgba(66, 165, 198, 0.22);
        }

        .brand-name {
            color: var(--brand-dark);
            font-weight: 750;
            letter-spacing: -0.3px;
        }

        .main-navbar .nav-link {
            padding: 9px 13px !important;
            color: var(--text-muted) !important;
            border-radius: 9px;
            font-weight: 600;
            transition: 0.2s ease;
        }

        .main-navbar .nav-link:hover {
            color: var(--brand-dark) !important;
            background: var(--brand-light);
        }

        .navbar-toggler {
            border-color: #c7dde5;
        }

        .navbar-toggler:focus {
            box-shadow: 0 0 0 3px rgba(66, 165, 198, 0.18);
        }

        .main-content {
            min-height: calc(100vh - 142px);
        }

        .site-footer {
            min-height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #75868e;
            background: #ffffff;
            border-top: 1px solid #e1ecef;
            font-size: 14px;
        }

        @@media (max-width: 576px) {
            .brand-name {
                font-size: 16px;
            }
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg main-navbar shadow-sm">
            <div class="container-fluid px-4 px-lg-5">
                <a class="navbar-brand d-flex align-items-center gap-3"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Landing">

                    <span class="brand-mark">M</span>

                    <span class="brand-name">
                        University Service Desk
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Home"
                                   asp-action="Landing">
                                    Home
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="ServiceRequests"
                                   asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            @if (User.IsInRole("Requester"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-area=""
                                       asp-controller="ServiceRequests"
                                       asp-action="Create">
                                        Create Request
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <span>
            University Service Desk — Developed by Marwah
        </span>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>