@{
    Layout = null;
    var destination = "/Home/Landing";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>University Service Desk</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
        }

        body {
            overflow: hidden;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                         Arial, sans-serif;
            background: #f5fbfd;
        }

        .welcome-page {
            position: relative;
            width: 100%;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            color: #173947;
            background:
                radial-gradient(
                    circle at 12% 15%,
                    rgba(112, 199, 222, 0.25),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 88% 85%,
                    rgba(169, 224, 238, 0.30),
                    transparent 30%
                ),
                linear-gradient(135deg, #f9fdfe, #edf8fb);
        }

        .circle {
            position: absolute;
            border: 1px solid rgba(60, 163, 194, 0.16);
            border-radius: 50%;
            animation: floating 5s ease-in-out infinite;
        }

        .circle-one {
            width: 260px;
            height: 260px;
            top: -120px;
            right: -70px;
        }

        .circle-two {
            width: 170px;
            height: 170px;
            bottom: -70px;
            left: -45px;
            animation-delay: 0.7s;
        }

        .welcome-content {
            position: relative;
            z-index: 2;
            max-width: 760px;
            text-align: center;
            animation: entrance 0.9s ease both;
        }

        .brand-icon {
            width: 90px;
            height: 90px;
            margin: 0 auto 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            background: linear-gradient(145deg, #6fc4dc, #3aa1c0);
            border-radius: 25px;
            font-size: 42px;
            font-weight: 800;
            box-shadow: 0 18px 40px rgba(58, 161, 192, 0.24);
            animation: iconEntrance 0.8s ease both;
        }

        .category {
            margin: 0 0 15px;
            color: #5195a9;
            font-size: 13px;
            font-weight: 750;
            letter-spacing: 4px;
            text-transform: uppercase;
        }

        h1 {
            margin: 0;
            color: #173947;
            font-size: clamp(40px, 6vw, 68px);
            font-weight: 800;
            line-height: 1.08;
            letter-spacing: -2px;
        }

        .description {
            max-width: 620px;
            margin: 22px auto 0;
            color: #637b85;
            font-size: clamp(16px, 2vw, 20px);
            line-height: 1.7;
        }

        .developer {
            margin: 40px 0 0;
            color: #7b9099;
            font-size: 14px;
        }

        .developer strong {
            color: #3499b7;
            font-weight: 750;
        }

        .loading-track {
            width: 190px;
            height: 4px;
            margin: 28px auto 0;
            overflow: hidden;
            background: #d8edf3;
            border-radius: 20px;
        }

        .loading-progress {
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, #77c9df, #3499b7);
            border-radius: inherit;
            transform-origin: left;
            animation: loading 2.5s linear both;
        }

        @@keyframes entrance {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes iconEntrance {
            from {
                opacity: 0;
                transform: scale(0.75) rotate(-7deg);
            }

            to {
                opacity: 1;
                transform: scale(1) rotate(0);
            }
        }

        @@keyframes loading {
            from {
                transform: scaleX(0);
            }

            to {
                transform: scaleX(1);
            }
        }

        @@keyframes floating {
            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(12px);
            }
        }

        @@media (max-width: 600px) {
            .brand-icon {
                width: 76px;
                height: 76px;
                font-size: 35px;
                border-radius: 21px;
            }

            h1 {
                letter-spacing: -1px;
            }
        }
    </style>
</head>

<body>
    <main class="welcome-page">
        <div class="circle circle-one"></div>
        <div class="circle circle-two"></div>

        <section class="welcome-content">
            <div class="brand-icon">M</div>

            <p class="category">IT Service Management</p>

            <h1>University Service Desk</h1>

            <p class="description">
                A simple and reliable way to report technical issues
                and follow their progress.
            </p>

            <p class="developer">
                Designed and developed by <strong>Marwah</strong>
            </p>

            <div class="loading-track">
                <div class="loading-progress"></div>
            </div>
        </section>
    </main>

   <script>
    window.setTimeout(function () {
        window.location.replace("@destination");
    }, 2500);
</script>
</body>
</html>